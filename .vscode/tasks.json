{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "增量+并行构建：只重编改动过的文件。产物在 bin/Debug-windows-x86_64/。SHELL=cmd.exe 是给 premake 生成的 postbuild（xcopy）用的",
            "type": "shell",
            "command": "mingw32-make",
            "args": [
                "-j8",
                "SHELL=cmd.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
